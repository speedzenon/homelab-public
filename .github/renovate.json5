{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':semanticCommits',
    'schedule:nonOfficeHours',
    'helpers:pinGitHubActionDigestsToSemver',
  ],
  timezone: 'Europe/Warsaw',
  labels: [
    'dependencies',
  ],
  prHourlyLimit: 4,
  prConcurrentLimit: 10,
  dependencyDashboard: {
    enabled: true,
    title: 'Renovate Dependency Dashboard',
  },
  argocd: {
    managerFilePatterns: [
      '/^kubernetes/apps/.+\\.ya?ml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/^kubernetes/infrastructure/.+\\.ya?ml$/',
    ],
  },
  'pre-commit': {
    enabled: true,
  },
  packageRules: [
    {
      description: 'Grupuj aktualizacje minor i patch w jeden PR (bez chartów klastra)',
      matchManagers: [
        '!argocd',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      groupName: 'all non-major dependencies',
    },
    {
      description: 'Charty klastra (ArgoCD Apps) — osobny PR na chart, osobna etykieta',
      matchManagers: [
        'argocd',
      ],
      addLabels: [
        'cluster-core',
      ],
    },
    {
      description: 'Gateway API CRD — bez automatycznych bumpów, podbijane ręcznie przed Cilium',
      matchManagers: [
        'argocd',
      ],
      matchDepNames: [
        'https://github.com/kubernetes-sigs/gateway-api.git',
      ],
      enabled: false,
    },
    {
      description: 'Cilium — w każdym PR przypomnienie o sprzężonej wersji CRD Gateway API',
      matchManagers: [
        'argocd',
      ],
      matchDepNames: [
        'cilium',
      ],
      prBodyNotes: [
        '⚠️ Sprawdź wymaganą wersję CRD Gateway API dla tej wersji Cilium (docs Cilium: Gateway API Support → Prerequisites). Jeśli jest nowsza niż w `kubernetes/apps/gateway-api-crds.yaml`, podbij ją osobnym PR-em i zmerguj go **przed** tym: nowsze CRD obsługują stare wersje API, odwrotnie nie.',
      ],
    },
    {
      description: 'Forgejo — major chartu tylko po akceptacji w Dependency Dashboard (linia LTS)',
      matchManagers: [
        'argocd',
      ],
      matchDepNames: [
        'code.forgejo.org/forgejo-helm/forgejo',
      ],
      matchUpdateTypes: [
        'major',
      ],
      dependencyDashboardApproval: true,
      prBodyNotes: [
        '⚠️ Sprawdź w README chartu (sekcja „Upgrading”), którą wersję Forgejo instaluje ten major. Trzymamy się linii LTS: 15 LTS do 15.07.2027, potem skok na 19 LTS. Przed upgrade’em kopia wolumenu `forgejo-data` (VolumeSnapshot) — migracje bazy są jednokierunkowe.',
      ],
    },
    {
      description: 'Chart Renovate (dla repozytoriów w Forgejo) — raz w tygodniu',
      matchManagers: [
        'argocd',
      ],
      matchDepNames: [
        'ghcr.io/renovatebot/charts/renovate',
      ],
      schedule: [
        '* 0-5 * * 1',
      ],
    },
    {
      description: 'Auto-merge pinów SHA dla GitHub Actions (niskie ryzyko)',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'digest',
        'pin',
      ],
      automerge: true,
    },
    {
      description: 'Ansible (infrastructure/ansible) — osobna grupa',
      matchFileNames: [
        'infrastructure/ansible/**',
      ],
      groupName: 'ansible',
      prBodyNotes: [
        'Po merge’u: `just runner-up` (VM runnera zwykle stoi), `just ansible runner --check --diff`, a gdy różnice wyglądają dobrze — `just ansible runner`.',
      ],
    },
    {
      description: 'Major updates — wyraźna etykieta, ostrożny review',
      matchUpdateTypes: [
        'major',
      ],
      addLabels: [
        'major-update',
      ],
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Aktualizuj wersje oznaczone komentarzem # renovate: (NAZWA_VERSION= oraz klucz: w YAML)',
      managerFilePatterns: [
        '/\\.ya?ml$/',
        '/\\.sh$/',
        '/Makefile$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+_VERSION\\s*=\\s*"?(?<currentValue>[^"\\s]+)"?',
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[\\w-]+:\\s*"?(?<currentValue>[^"\\s]+)"?',
      ],
    },
  ],
}
