{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // Presety bazowe — sprawdzone zestawy ustawień od społeczności Renovate
  extends: [
    'config:recommended',                       // rozsądne defaulty
    ':semanticCommits',                         // commity w formacie Conventional Commits
    'schedule:nonOfficeHours',                  // PR-y poza godzinami pracy
    'helpers:pinGitHubActionDigestsToSemver',   // pinuj Actions do SHA + komentarz wersji
  ],

  timezone: 'Europe/Warsaw',
  labels: ['dependencies'],

  // Limity, by nie zalać się PR-ami
  prHourlyLimit: 4,
  prConcurrentLimit: 10,

  // Dashboard jako GitHub Issue — centralny widok wszystkich zależności
  dependencyDashboard: true,
  dependencyDashboardTitle: 'Renovate Dependency Dashboard',

  // Wersje chartów w Application-ach ArgoCD (Cilium, ArgoCD, democratic-csi,
  // snapshot-controller). Manager argocd NIE ma domyślnych wzorców plików —
  // bez tego Renovate nigdy nie podbijał rdzenia stacku. justfile czyta wersje
  // z tych plików, więc jeden bump aktualizuje też instalację helm CLI.
  argocd: {
    managerFilePatterns: ['/^kubernetes/apps/.+\\.ya?ml$/'],
  },

  // Hooki pre-commit (gitleaks, yamllint, ...) — manager domyślnie wyłączony.
  'pre-commit': {
    enabled: true,
  },

  packageRules: [
    {
      description: 'Grupuj aktualizacje minor i patch w jeden PR (bez chartów klastra)',
      matchManagers: ['!argocd'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'all non-major dependencies',
    },
    {
      // Merge = automated sync: roll CNI (Cilium), upgrade samego ArgoCD, sterownika CSI.
      description: 'Charty klastra (ArgoCD Apps) — osobny PR na chart, osobna etykieta',
      matchManagers: ['argocd'],
      addLabels: ['cluster-core'],
    },
    {
      // Wersja CRD musi pasować do kontrolera w Cilium (Cilium 1.20 <-> v1.6.3).
      // Samodzielny bump mógłby wgrać CRD, których zainstalowany Cilium nie obsługuje.
      // Manager argocd nadaje źródłom git depName = repoURL.
      description: 'Gateway API CRD — bez automatycznych bumpów, podbijane ręcznie przed Cilium',
      matchManagers: ['argocd'],
      matchDepNames: ['https://github.com/kubernetes-sigs/gateway-api.git'],
      enabled: false,
    },
    {
      description: 'Cilium — w każdym PR przypomnienie o sprzężonej wersji CRD Gateway API',
      matchManagers: ['argocd'],
      matchDepNames: ['cilium'],
      prBodyNotes: [
        '⚠️ Sprawdź wymaganą wersję CRD Gateway API dla tej wersji Cilium (docs Cilium: Gateway API Support → Prerequisites). Jeśli jest nowsza niż w `kubernetes/apps/gateway-api-crds.yaml`, podbij ją osobnym PR-em i zmerguj go **przed** tym: nowsze CRD obsługują stare wersje API, odwrotnie nie.',
      ],
    },
    {
      description: 'Auto-merge pinów SHA dla GitHub Actions (niskie ryzyko)',
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['digest', 'pin'],
      automerge: true,
    },
    {
      description: 'Major updates — wyraźna etykieta, ostrożny review',
      matchUpdateTypes: ['major'],
      addLabels: ['major-update'],
    },
  ],

  customManagers: [
    {
      customType: 'regex',
      // Dwa zapisy pod komentarzem '# renovate: ...':
      //   NAZWA_VERSION="x"  - skrypty, bloki run: w workflow (np. TOFU_VERSION)
      //   klucz: x           - YAML (np. pin node w .pre-commit-config.yaml)
      description: 'Aktualizuj wersje oznaczone komentarzem # renovate: (NAZWA_VERSION= oraz klucz: w YAML)',
      managerFilePatterns: [
        '/\\.ya?ml$/',
        '/\\.sh$/',
        '/Makefile$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+_VERSION\\s*=\\s*"?(?<currentValue>[^"\\s]+)"?',
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[\\w-]+:\\s*"?(?<currentValue>[^"\\s]+)"?',
      ],
    },
  ],
}
