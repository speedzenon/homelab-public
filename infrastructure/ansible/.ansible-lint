---
# ansible-lint (hook pre-commit uruchamia go z '-c' na ten plik, wiec katalog
# projektu = infrastructure/ansible). Profil 'production' - najostrzejszy.
profile: production
exclude_paths:
  - .ansible/
  - .venv/
  # pliki SOPS to szyfrogram, nie YAML do lintowania
  - secrets/
skip_list:
  # Kolekcja speedzenon.homelab nie trafia do Ansible Galaxy - inne repo instaluje ja
  # z gita po SHA, wiec dziennik zmian to historia gita, a licencja repo to osobna decyzja
  - galaxy[no-changelog]
  - galaxy[no-license]
